# Token do bot obtido via BotFather
TELEGRAM_TOKEN=<token via BotFather>

# Chat ID autorizado (obtenha do seu bot; NÃO commitar valores reais)
TELEGRAM_CHAT_ID=<seu chat id>

# DARIUS Server (opcional)
# PORT=3000
# BIND_HOST=127.0.0.1
# CORS_ORIGIN=http://localhost:5173
# DB_PATH=darius_live.db
# OLLAMA_URL=http://127.0.0.1:11434

# Fronteira mínima de auth da API (opt-in). Se definido, todas as rotas /api
# (exceto /api/health) exigem "Authorization: Bearer <token>" ou
# "x-darius-token: <token>". Deixe vazio para localhost sem auth.
# DARIUS_API_TOKEN=
